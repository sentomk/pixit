{
	"name": "@sentomk/pixit",
	"version": "0.2.0",
	"description": "SentoMK's pi coding agent extensions: Vim prompt editing with custom mappings, questionnaire, xedit, and custom status footer",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sentomk/pixit.git"
	},
	"type": "module",
	"files": [
		"extensions",
		"themes"
	],
	"keywords": [
		"pi-package",
		"pi-extension"
	],
	"pi": {
